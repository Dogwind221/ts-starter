{
  "name": "@ts-starter/lib",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared TypeScript library (ESM+CJS+d.ts via tsup) for the ts-starter monorepo.",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "typescript",
    "library",
    "starter",
    "vite",
    "vitest",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dogwind221/ts-starter.git"
  },
  "bugs": {
    "url": "https://github.com/Dogwind221/ts-starter/issues"
  },
  "homepage": "https://github.com/Dogwind221/ts-starter#readme",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "vitest": "^3.0.0"
  }
}
