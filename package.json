{
  "name": "ts-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:web": "pnpm --filter @ts-starter/web dev",
    "dev:cli": "pnpm --filter @ts-starter/cli dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "typescript": "^5.7.2"
  }
}
